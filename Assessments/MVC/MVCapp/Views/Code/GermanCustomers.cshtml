@model IEnumerable<MVCapp.Models.Customer>

<h2>Customers from Germany</h2>

<table border="1">
    <tr>
        <th>ID</th>
        <th>Company Name</th>
        <th>City</th>
    </tr>

    @foreach (var c in Model)
    {
        <tr>
            <td>@c.CustomerID</td>
            <td>@c.CompanyName</td>
            <td>@c.City</td>
        </tr>
    }
</table>
